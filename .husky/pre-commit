#!/usr/bin/env sh
# ============================================================================
# PEAR pre-commit
# ----------------------------------------------------------------------------
# Ordered fastest-to-slowest so a broken commit fails in seconds, not minutes.
# Stage 3 only runs when the prompt engine (lib/prompts.js) or its inputs are staged.
# ============================================================================

echo "🍐 PEAR pre-commit"

APP="fitting-room/app.js"
STAGED=$(git diff --cached --name-only)

# ── 1. Regression suite (the guardrail) ────────────────────────────────────
echo ""
echo "▸ regression suite"
npm run test:unit || {
  echo ""
  echo "✖ A regression test failed."
  echo "  These encode bugs that already shipped once. Do NOT delete the"
  echo "  assertion to go green — fix the change, or update the test AND the"
  echo "  comment block that records why the rule exists."
  exit 1
}

# ── 2. Cross-file lockstep (see CLAUDE.md §3) ──────────────────────────────
# These functions are duplicated across bundles with no shared module system.
# Changing one copy without the other is silent and the failure surfaces only
# in production, on one merchant's catalog.
echo ""
echo "▸ cross-file lockstep"
touched_widget=$(echo "$STAGED" | grep -c "pear-widget.js" || true)
touched_room=$(echo "$STAGED"   | grep -c "app.js" || true)

if [ "$touched_widget" -gt 0 ] && [ "$touched_room" -eq 0 ]; then
  for fn in canonicalPhoto upgradeImageUrl createGarmentComposite sampleBackdrop; do
    if git diff --cached -U0 -- '*pear-widget.js' | grep -q "$fn"; then
      echo "  ⚠ $fn changed in pear-widget.js but app.js is not staged."
      echo "    Its twin (canonicalImageUrl / createGarmentComposite / sampleBackdrop)"
      echo "    must move with it — see CLAUDE.md §3."
      echo ""
      printf "    Commit anyway? [y/N] "
      read -r reply </dev/tty
      case "$reply" in [Yy]*) ;; *) echo "✖ blocked."; exit 1;; esac
      break
    fi
  done
fi
echo "  ok"

# ── 3. Prompt drift — when the prompt engine (or what feeds it) is staged ────
# The engine lives in lib/prompts.js since 2026-09-26 (server-side; CLAUDE.md §2.13).
# app.js is still a trigger: it sends the facts the engine reads (promptFactsOf()),
# and the verdict isBottomsGarment() it honours. config.js holds the budget.
PROMPTS="lib/prompts.js"
if echo "$STAGED" | grep -qE "(^|/)(prompts\.js|app\.js|config\.js)$"; then
  echo ""
  echo "▸ prompt trace (prompt engine or its inputs staged)"

  # trace-prompt.mjs resolves PROMPT_MAX_CHARS from config.js - beside app.js in the old
  # layout, or ../fitting-room/config.js beside lib/prompts.js. So the HEAD-side snapshot
  # mirrors the real directory layout: a bare /tmp copy would have no config.js to find.
  HEAD_SNAPSHOT_DIR="/tmp/pear-head-snapshot"
  rm -rf "$HEAD_SNAPSHOT_DIR" 2>/dev/null
  mkdir -p "$HEAD_SNAPSHOT_DIR/lib" "$HEAD_SNAPSHOT_DIR/fitting-room"
  git show HEAD:fitting-room/config.js > "$HEAD_SNAPSHOT_DIR/fitting-room/config.js" 2>/dev/null || true

  # What the wire looks like in HEAD vs. what is about to be committed. HEAD traces
  # lib/prompts.js when it has one, else app.js - which is how the commit that MOVED the
  # engine compares the old browser engine against the new server one.
  head_trace_ok=1
  HEAD_TARGET=""
  if git show HEAD:"$PROMPTS" > "$HEAD_SNAPSHOT_DIR/$PROMPTS" 2>/dev/null; then
    HEAD_TARGET="$HEAD_SNAPSHOT_DIR/$PROMPTS"
  elif git show HEAD:fitting-room/app.js > "$HEAD_SNAPSHOT_DIR/fitting-room/app.js" 2>/dev/null; then
    HEAD_TARGET="$HEAD_SNAPSHOT_DIR/fitting-room/app.js"
  fi
  if [ -n "$HEAD_TARGET" ]; then
    if node scripts/trace-prompt.mjs "$HEAD_TARGET" --json > /tmp/pear-prompt-head.json 2>/dev/null; then
      head_trace_ok=0
    else
      head_trace_ok=$?
    fi
  fi

  node scripts/trace-prompt.mjs "$PROMPTS" --json > /tmp/pear-prompt-new.json || {
    echo "  ✖ the prompt trace failed - a branch is OVER the Decart budget, or $PROMPTS"
    echo "    could not be traced. Run: npm run trace:prompt"
    exit 1
  }

  if [ "$head_trace_ok" -eq 0 ] && [ -s /tmp/pear-prompt-head.json ]; then
    if diff -q /tmp/pear-prompt-head.json /tmp/pear-prompt-new.json >/dev/null; then
      echo "  = wire strings UNCHANGED by this commit."
      echo "    If this commit was meant to change how the garment renders,"
      echo "    it did not: you likely edited a dead clause (CLAUDE.md §0)."
      echo "    Run: npm run trace:prompt"
    else
      echo "  ± wire strings CHANGED — verify this was intended:"
      node scripts/trace-prompt.mjs "$PROMPTS" | sed -n '/reach Decart/,/REACHABILITY/p' | head -30
    fi
  else
    echo "  ⊘ HEAD-side trace unavailable, skipping wire-diff for this commit."
  fi
fi

# ── 4. API + E2E ───────────────────────────────────────────────────────────
# These two come from a separate bundle that is NOT installed in this repo.
# Guarded deliberately: a hook that fails every commit on a missing script
# gets disabled wholesale, taking stages 1-3 down with it. When the API/E2E
# bundle lands and defines these scripts, the guard stops firing on its own
# and both stages become blocking with no edit here.
has_script() {
  node -e "process.exit(require('./package.json').scripts?.['$1'] ? 0 : 1)" 2>/dev/null
}

echo ""
echo "▸ api health"
if has_script test:api; then
  npm run test:api || { echo "✖ API tests failed."; exit 1; }
else
  echo "  ⊘ SKIPPED — no 'test:api' script in package.json (API bundle not installed)."
fi

echo ""
echo "▸ widget e2e"
if has_script test:e2e; then
  npm run test:e2e || {
    echo "✖ Widget E2E failed. Debug with: npm run test:e2e:ui"
    exit 1
  }
else
  echo "  ⊘ SKIPPED — no 'test:e2e' script in package.json (E2E bundle not installed)."
fi

echo ""
echo "✅ all checks passed"
